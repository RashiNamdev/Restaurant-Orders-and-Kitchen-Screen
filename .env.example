# Restaurant Orders & Kitchen Display System - Root Configuration Template

# Backend Server Port
PORT=5000

# Node Environment Mode (development | test | production)
NODE_ENV=development

# MongoDB Connection URI (Local MongoDB or Atlas Cloud)
# Local:
MONGODB_URI=mongodb://127.0.0.1:27017/restaurant_db
# Cloud Atlas Example:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/restaurant_db?retryWrites=true&w=majority

# CORS Allowed Origins (Comma-separated for multiple clients)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000
SOCKET_CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000

# Client environment variables (for reference in /client/.env)
# VITE_API_URL=http://localhost:5000/api
# VITE_SOCKET_URL=http://localhost:5000
