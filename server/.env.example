# Server Port
PORT=5000

# Environment Mode (development | test | production)
NODE_ENV=development

# MongoDB Connection URI
# Option 1: Local MongoDB (Default)
MONGODB_URI=mongodb://127.0.0.1:27017/restaurant_db
# Option 2: MongoDB Atlas (Cloud) - Replace with your Atlas connection string
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/restaurant_db?retryWrites=true&w=majority

# Allowed Frontend Origins (Comma-separated for multiple URLs)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000
SOCKET_CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000
